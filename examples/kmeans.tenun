// Pengklasteran k-means: menemukan 2 klaster tanpa label.
// Jalankan: tenun run examples/kmeans.tenun
impor "../src/belajar.tenun";

biar X: [][]desimal = [
    [1.0, 1.0], [1.2, 0.8], [0.8, 1.1],
    [9.0, 9.0], [9.2, 8.8], [8.8, 9.1]
];

biar pusat: [][]desimal = kmeans(X, 2, 10);
cetak("pusat klaster:");
untuk c dari 0 sampai panjang(pusat) {
    cetak(pusat[c][0]);
    cetak(pusat[c][1]);
}

cetak("penugasan klaster tiap titik:");
biar tugas: []desimal = klaster_tugas(pusat, X);
untuk i dari 0 sampai panjang(tugas) {
    cetak(tugas[i]);
}
